PORT=8000
NODE_ENV=development

# Khớp với docker-compose.yml (Postgres map ra cổng 5433 trên máy host)
DATABASE_URL=postgres://vlearn:vlearn@localhost:5433/vlearn

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Origin của frontend, phân tách bằng dấu phẩy
CORS_ORIGIN=http://localhost:5173
