PORT=8000
NODE_ENV=development

# Khớp với docker-compose.yml (Postgres map ra cổng 5433 trên máy host)
DATABASE_URL=postgres://vlearn:vlearn@localhost:5433/vlearn

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Origin của frontend, phân tách bằng dấu phẩy
CORS_ORIGIN=http://localhost:5173

# Trợ giảng AI — để trống OPENAI_API_KEY thì chạy chế độ mock
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ROUTER_MODEL=gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
AGENT_CONFIDENCE_FLOOR=0.6

# RAG cho router. Ba biến EMBED_* chỉ đọc lúc dựng chỉ mục (npm run rag:index);
# lúc chạy, câu hỏi luôn được nhúng bằng đúng model ghi trong eval/index/lesson_embeddings.json.
# EMBED_PROVIDER=openai          # mặc định theo AI_PROVIDER
# EMBED_MODEL=text-embedding-3-large
# EMBED_DIMS=1024
# RAG_CANDIDATES=10              # số ứng viên (chỉ tiêu đề) đưa cho router mỗi lượt
